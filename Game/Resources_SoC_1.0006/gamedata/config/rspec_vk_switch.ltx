; Vulkan renderer quality preset - SWITCH (минимум; бывший Potato)
;
; 03-10-2026: Potato и консольный набор Switch слиты в ОДИН пресет. Код один на
; ПК и Switch; Switch = платформенный слой + этот файл. На консоли он
; исполняется при каждом старте (x_ray.cpp execUserScript, `_preset Switch`),
; на ПК выбирается в меню как самый нижний тир (и стоит по умолчанию,
; ps_preset = 5). Старое имя `_preset Potato` -- синоним, user.ltx не ломается.
;
; Часть 1 -- бывший Potato (пол, замерен на ПК 18-09: GPU 1.06 мс, CPU 4.00).
; Часть 2 -- то, что Switch выставлял в коде (kNxLean/kNxOff/kNxBare) и что
; после слияния копий nfsmw стало кварами вместо #ifdef __SWITCH__. Порядок
; строк = порядок, в котором их исполнял x_ray.cpp: поздние перекрывают ранние.
;
; Чисто платформенное осталось в коде: r_render_scale по размеру экрана
; (540p внутри), отладочные ключи -nx_*.
;
; ⚠Квары, читаемые при создании пайплайнов/карт теней (r_sun_casc_lite,
; r_world_flat, r_grass_gen, r_grass_r1, r_tree_r1, r_tree_sky_push,
; r_tree_crown_bake), вступают в силу с загрузки уровня / перезапуска.
;
; Загружать: _preset Switch  (или cfg_load <путь>\rspec_vk_switch.ltx)
; Вернуться: _preset Default
;
; ⚠Значения выбраны по РЕАЛЬНЫМ границам из vk_console_min.cpp, а не на глаз:
; команда с числом вне диапазона молча зажимается, и тогда пресет врёт о том,
; что он сделал. И ноль не везде значит "выключено" -- см. r_fog_dist и
; r_tree_dist ниже, на обоих я наступил.

; ================================================================ ЧАСТЬ 1 (Potato)
; *** МАСШТАБ. AA выключен СОВСЕМ, а не переведён в dlss_performance: низкий
; тир, опирающийся на апскейлер, отвечает не на тот вопрос (на Switch его нет).
r_render_scale 1.
r_aa_mode st_opt_off
r_dlss 0
r_dlss_fg 0

; *** ТЕНИ -- совсем.
;
; ⚠⚠r_shadows Off -- ЭТО НЕ «тени выключены». Тир гасит СОЛНЕЧНЫЙ АТЛАС
; (ps_r_vsm = 0, 14.62 мс из 75 на 780M -- единственный крупный блок кадра,
; который НЕ дешевеет от render_scale). Мимо него идут ТРИ отдельных пути, и
; 18-09 их было видно на экране при «выключенных» тенях:
;   r_gpu_shadows / r_gpu_shadows_at -- тени локальных источников
;   r_shadow_cluster / r_shadow_lod  -- кластерные тени
;   r_ao_gi                          -- затеняющий член в освещении
; ⛔А ЗАПЕЧЁННЫЕ ТЕНИ В ЛАЙТМАПАХ НЕ ГАСЯТСЯ НИЧЕМ: они в текстурах уровня,
; это контент, а не фича рендера. Для низкого тира это в плюс -- бесплатная
; статическая тень остаётся, когда всё динамическое снято.
; ⭐r_sun_shadows 0 — добавлен в движок 18-09-2026 именно здесь и из-за этого
; пресета: без него каскадная солнечная тень рисовалась ВСЕГДА (Pass_SunShadow
; не имел гейта по качеству), и SunShadow 1.85 мс оставалась самой дорогой
; зоной кадра при «выключенных» тенях.
r_sun_shadows 0
r_shadows Off
r_gpu_shadows 0
r_gpu_shadows_at 0
r_shadow_cluster 0
r_shadow_lod 0
r_shadow_casc_cache 1
r_ao_gi 0.
r_sun_grass_dist 5.

; *** ЗАТЕНЕНИЕ И ВТОРИЧНЫЙ СВЕТ -- совсем.
r_ssao 0
r2_ssao st_opt_low
r_ssao_strength 0.
r_ssil 0
r_ssil_strength 0.
r_spec_occ 0.
r_ibl 0
r_sky_sh 0

; *** GI -- вся цепочка вниз (Gather + DDGI + WRC = 9.3 мс из 75 на 780M).
r_gi off

; *** ДАЛЬНОСТЬ. rs_vis_distance снизу 0.4 => far_plane ~160 м вместо ~1600.
; Это единственный рычаг, который режет НАБОР ГЕОМЕТРИИ, а значит и CPU:
; куллинг, обход, набор кастеров. Остальное режет только пиксели.
; ⚠Команда тумана называется r_fog_dist (0..8), а НЕ rs_fog_distance: на
; последнюю движок отвечает `Unknown command`, и строка молча не работает.
; ⚠⚠И у неё 0 = ВЫКЛЮЧЕНО, а не «ближе» (дефолт 4.0). 18-09 я написал 0.4,
; думая «меньше дальность», и тем самым СГУСТИЛ туман вместо того, чтобы его
; убрать — юзер увидел это на экране раньше, чем я в коде.
rs_vis_distance 0.4
; 10-10: 1 = туман погоды, кончается РОВНО на дальней плоскости (fog_distance <= far_plane_render - 10,
; Environment_misc.cpp) -- мир растворяется в тумане вместо обрыва на ~160 м. Было 0 (выкл) = обрыв.
r_fog_dist 1.
; 10-10: небо у горизонта уходит в цвет тумана (до ~11.5° = sin 0.2) -- отсечённый, уже полностью затуманенный край
; мира не мелькает серыми силуэтами на фоне неба при повороте камеры. 0 = выкл.
r_sky_fog_horizon 0.2
; 10-10: туман уходит в НЕБО за объектом (кубмапа погоды по лучу взгляда x оттенок неба), а не в один fog_color --
; затуманенная ёлка на горе не вылезает серым силуэтом, когда отсечение по плоскости заметает край мира при повороте.
r_fog_sky 1

; *** ИСТОЧНИКИ СВЕТА
r_light_cones 0
r_light_cone_density 1.
r_flashlight_glow 0.

; *** ОБЪЁМ, ОБЛАКА, ДОЖДЬ -- совсем.
r_vol 0
r_vol_ms 1
r_vol_ta 0
r_vol_upsample 0
r_vol_mist 0.
r_vol_smoke 0.
r_vol_smoke_shadow 0.
r_clouds 0
r_clouds_steps 16
; 10-10: дождь из R1 (капли, всплески, МОЛНИЯ -- r_rain 0 гасил и её). Цена только в дождь: GPU ~0.2 ед., CPU главного потока
; ~1 мс при 1000 каплях. r_rain_rq_static: лучи рождения капель только по статике (с NPC было 2.2 мс физики, стало 0.8).
; r_tree_r1_wet: R1-крона и в дождь (иначе состояние «мокро» отправляло все кроны в полный шейдер: 0.45 -> 1.5-3.6 ед.).
r_rain 1
r_rain_rq_static 1
; 10-10: лучи капель по статике -- из кэша высот (клетки 0.5 м, по одному вертикальному лучу на клетку): ~5.8 % главного
; потока в большом бою под дождём. 0 = настоящий луч на каждую каплю.
r_rain_hcache 1
; капель 700 (на Switch по умолчанию 1000): физика капель ~0.8 → ~0.55 мс главного потока; в бою под дождём на пике не хватало ~1 мс
r_rain_drops 700
; экраны RmlUi не перечитывают .rcss при каждом открытии (1 = для правки стилей на ПК): инвентарь собирался 66 мс; первый
; инвентарь в бою был кадром 129 мс -- теперь его документ и текстура прогреваются за экраном загрузки
ui_rml_live_rcss 0
r_tree_r1_wet 1
r_sunshafts_mode st_opt_off

; *** РАСТИТЕЛЬНОСТЬ.
; ⚠⚠r_tree_dist 0 -- ЭТО НЕ «деревьев нет». Комментарий у команды:
; «forward tree mesh range where an FLOD billboard takes over (0 = off, draws
; both)», и TreeFlodCutDist() возвращает 0 = «срез отключён», а maxDist
; откатывается на 250 м. 18-09 я написал сюда 0 и заставил деревья рисоваться
; БОЛЬШЕ, а потом принял это за баг движка. Правильно -- малое ПОЛОЖИТЕЛЬНОЕ:
; билборд перехватывает сразу (ниже kImposterMinDist всё равно не опустится,
; иначе дерево исчезло бы совсем, а не заменилось).
; ⚠А ТРАВУ ВЫКЛЮЧИТЬ НЕЧЕМ: пасс "Grass" в CRender_Vulkan.cpp:1551 не имеет
; гейта, а r__detail_radius снизу ограничен 70 м. Поэтому здесь трава лишь
; максимально разрежена и обрезана по альфе. Нужен cvar r_grass 0/1 -- его нет.
r_tree_dist 1.
r_tree_shade_dist 0.
r_tree_hzb 1
r__detail_density 0.9
r__detail_radius 70
r__detail_scale 0.7
r_grass_aref 0.9
r_wind_tree_bend 0.
r_hzb_cull 1
r_vrs 2

; *** ПОВЕРХНОСТИ
r_pom 0
r_pom_steps 8.
r_pom_terrain 0
r_bump 0.
r_terrain_detail_dist 30.
r_wet_dist 20.
r_wet_refl 0.
r_puddle_level 0.
r_snow_deform 0

; *** ВОДА. 12-10: лёгкий вариант r_wtr_lean 1 (water_lean.frag.spv: без тесселяции, без
; копии сцены/каустик, без укрытия по карте дождя, без FFT/ряби/прибоя, 6 октав волн,
; тень солнца R1-выборкой). r_wtr пока 0 -- включить после замера у пруда Кордона.
; r_wtr_wet 0: карта высот воды уровня 2048^2 (16 МБ, растр каждые 4 кадра) -- только
; для мокрого берега, лёгкой воде не нужна.
r_wtr 0
r_wtr_lean 1
r_wtr_tess 0
r_wtr_refl 1.
r_wtr_refract 0.
r_wtr_caustic 0.
r_wtr_shelter 0.
r_wtr_wet 0.
r_wtr_sim 0
r_wtr_fft 0

; *** ПОТРЕБИТЕЛИ, КОТОРЫЕ ДЕРЖАТ ЧУЖИЕ ПАССЫ ЖИВЫМИ.
;
; ⭐18-09 я решил, что четыре пасса «игнорируют свои квары», и чуть не полез
; чинить исправный движок. На деле каждый из них держал ДРУГОЙ потребитель,
; и все они гейтятся ровно как написано в коде:
;   Shadow/Rain  <- r_light_occ: окклюзия динамического света читает карту дождя
;   Deform       <- r_mud_deform: «mud prints need the field year-round»
;   MotionVecDyn <- r_motion_vectors (MotionVec::Enabled), а не r_aa_mode
; Без этих строк «всё выключено» оставляло 0.8 мс из 3.1 GPU-мс на работу,
; которую я считал выключенной. Урок: гейт ищут в коде пасса, а не по имени квара.
r_light_occ 0
r_mud_deform 0.
r_snow_deform_tex 0
r_motion_vectors 0
r_water_sim 0

; *** ОСТАТКИ, найденные аудитом ненулевых зон профайлера 18-09.
; Всё это отдельные фичи со своими кварами, которых пресет не касался.
; ⛔НЕ трогаем r_preskin (=1): это ОПТИМИЗАЦИЯ (пре-скиннинг в пул), её
; отключение переносит стоимость, а не убирает. То же про r_lods_gpu/r_hzb_*.
r_sun_beam 0.
r_ibl 0
r_ibl_spec 0.
r_terrain_ao 0.
r_terrain_normal 0.
r_terrain_gloss 0.
r_glass_refr 0.
r__geometry_lod 0.1
r__wallmark_ttl 1.
; Диагностический форс самой грубой частоты затенения на World-пассе
; (комментарий в коде: «force pipeline-rate NxN, ignoring the SRI»). Картинка
; становится блочной -- для ПОЛА это честно, для игры нет.
r_vrs_force 0

; *** ИЗОБРАЖЕНИЕ
r_blm 0.
r_dither 0.
r_txstream 1
r_gpu_particles 0

; ================================================================ ЧАСТЬ 2 (Switch)
; Кластерное отсечение света (vk_clustered) стоило ~7 с GPU на кадр на GM20B
; (-nx_sweep, 30-09: r_clustered 0 -> 120 мс). Шейдеры уходят на простой путь.
r_clustered 0
; Hi-Z препасс: 137-147 мс/кадр против 92-97 без него (-nx_sweep в игре).
r_hzb_prepass 0

; --- lean-путь (01-10): у R1 одна растеризация на объект, всё, что существует
; ради второй, выключено: препасс деревьев/NPC, пул пре-скина, Hi-Z, процедурное небо.
r_tree_prepass 0
r_preskin 0
r_tonemap_lean 1
r_tree_mesh_dist 40
r_bones_mt 2
; 12-10: кости мировых скелетов дальше 25 м -- раз в 2 кадра (30 Гц). Бой 12 бандитов: 57.4/57.8 fps против 56.7/55.9
r_bones_lod_dist 25
mem_item_access_cache 1
rs_sheduler_max 1.0
r_hzb_cull 0
r_tree_hzb 0
r_sky_proc 0

; --- всё в цветовом проходе мира, что можно выключить (v52-v54)
r_tess 0
r_pom 0
r_pom_terrain 0
r_pom_shadow 0
r_pom_ao 0
r_bump 0
r_terrain_normal 0
r_terrain_ao 0
r_terrain_gloss 0
r_gloss_scale 0
r_ao_flat 0
r_terra_cone 0
r_terra_horizon 0
r_ibl_spec 0
r_spec_occ 0
r_wet_refl 0
r_snow_mesh 0
r_snow_deform 0
r_sf 0
r_wtr_tess 0
r_wtr_fft 0
r_wtr_sim 0
r_water_sim 0
r_glass_refr 0
r_ssao 0
r_ssil 0
r_rtao 0
r_ddgi 0
r_vol 0
r_clouds_vol 0
r_light_occ 0
r_motion_vectors 0
r_mv_prepass 0
r_fsr 0

; --- минимальная сцена (30-09) + живые каскады солнца (nfs43-47)
r_shadows Off
r_sun_shadows 1
r_sun_casc_lite 1
; дальняя карта солнца (320 м, только за каскадами): 512 = 62 см на тексель (профиль lite 1024 = 31 см; на глаз то же). Читается при
; старте рендера. Кроны в неё только до 100 м от центра: перерисовка 6.7 → 2.4 мс GPU (10-10 v308: статика 2.0→1.4, кроны 4.3→1.0);
; дальше 100 м кроны в тумане, самозатенение не видно (60 м уже видно). r_sun_far_trees 0 = крон нет совсем (−1.0 мс, кроны светлеют).
r_sun_far_size 512
r_sun_far_tree_dist 100
r_sun_mask 1
r_sun_vis_probe 1
; 10-09: каскады солнца целиком из кэша (живые слои только вместе с кэшем: тени деревьев в позе покоя), тени NPC выкл
r_capsule_shadow 0
r_sun_cad_npc 0
r_sun_cad_c0 0
r_sun_cad_c1 0
r_tree_shadow_lod 1
r_shadow_casc_sun 0.5
r_vsm 0
r_light_cap 0
r_spot_pool 1
; фонарик (10-09, A/B v279-v281 на 5 точках): тайл 512 вместо 1024 (+0.9 мс), приём одной gather-выборкой,
; NPC в его тени только ближе 10 м. Крона R1 берёт фонарик сама (r_tree_r1_dyn 1, дефолт): иначе Trees 1.2 -> 6-8 мс.
r_spot_scale 0.5
r_spot_pcf 0
r_spot_npc_dist -1
; тень x куки фонарика считаются в маске солнца (канал A), R1-статика/терейн без LAMPSH-варианта (v282: 55.1 -> 56.2 fps)
r_flash_mask 1
; мипы сцены + экспонометр раз в 4 кадра (адаптация той же скорости, Tonemap/Mips 0.16 -> 0.07, v283)
r_expo_interval 4
; GPU-мир: ~600 групп по материалам -> ~55 bindless (глубина 0.78 -> 0.49 ед., v289-v290)
r_world_bindless 1
r_spot_grass 0
r_sun_grass 0

; --- трава: R1 (nfs22) + облегчённый генератор (nfs33-41), минимальный радиус, без теней
r_grass 1
r_grass_nowave 0
r__detail_radius 45
r_grass_thin 0
r_spot_grass_shadow 0
r_grass_gen 2
r_grass_r1 2

; --- деревья: ветер как на ПК (nfs20), подсветка кроны x1.5 (nfs19), R1-LOD (nfs21/23), R1-крона
r_wind_tree_bend 0.18
r_wind_tree_anim 11
r_wind_tree_trunk 0.15
r_wind_tree_flutter 4
r_tree_sky_boost 1.5
r_tree_lod_size 1
r_tree_swi 0
r_tree_dist 1
r_tree_lod_band 1.33
r_tree_r1 1
r_tree_sky_push 1
r_tree_crown_bake 0

; --- NPC: LOD скелетов по R4 (агрессивнее), HOM + лучи по cform
r_skin_lod 1
r_skin_lod_k 4
; ST-листья: окна 50/25/12 % прямо при загрузке модели (07-10). 0: их строит фон (r_skin_lod_bg), без затрат на загрузку и спавн.
r_skin_st_lod 0
; Свои LOD-окна 50/25/12 % (meshoptimizer) для ВСЕХ скелетных моделей, кроме HUD: тела сталкеров, трупы, мутанты (PM: окна мода
; почти ничего не убирают), оружие в руках NPC, артефакты, предметы (09-10 v302: оружие и артефакты = большая часть треугольников
; скинов в лагерях). Строятся в фоновом потоке (ядро 2), свой индексный буфер; с 6 м, каждое следующее вдвое дальше. 0 = выкл. и не строить.
r_skin_lod_bg 6
; 10-10: оружие NPC -- своя лестница LOD: 50% с 0.5 м, 25/12/6/3% с 1/2/4/8 м (юзер: «с 5 м его почти не видно») (2 окна глубже, чем у тел). Винчестер на 5 м
; рисовал все 111k треугольников, в бою w.skinned 1.1 -> 3.25 ед. 0 = как у тел (r_skin_lod_bg).
r_skin_lod_wpn 0.5
; 10-10: руки и оружие от первого лица -- фиксированное LOD-окно (1 = 50%, 2 = 25%, 0 = полная модель). Убрать ствол =
; w.skinned 1.28 -> 0.12 ед. (~1.9 мс). Окна строятся при загрузке модели только при > 0.
r_skin_hud_lod 1
; 10-10: тень солнца на руках/оружии от первого лица -- по вершинам, а не 4 выборки каскада на каждый пиксель HUD
; (постоянная часть цены ствола в руках). Блики сквозь листву на руках остаются, чуть мягче. 0 = как было.
r_hud_vsun 1
; NPC в препассе глубины не идут (их вершины иначе считаются лишний раз; 07-10 A/B v186: 57.8 → 59.2 fps, >33 мс 14 → 2)
r_skin_prepass_dist 0
; тени персонажей капсулами вместо каскада солнца (07-10 A/B v186: 57.0 → 59.1 fps, лучше на всех точках). 0 = как раньше
r_shadow_lite 1
; кости из окна dynamic UBO (константный банк NVK) вместо SSBO (память); A/B окнами = nx_skinab.txt
r_skin_ubo 1
r_dyn_occ 2
r_dyn_occ_ppx 8
; IK ступней (лучи под каждую ногу каждый кадр): в кадре до 30 м, вне кадра до 10 м; дальше -- чистая анимация.
; 07-10 бой в деревне Кордона: IK = 11.6% главного потока, бандиты в 15-50 м (игра: 100 / 20)
ph_ik_dist 30
ph_ik_near_dist 10
; предел одного шага сборщика Lua (мкс): разметка и sweep режутся по кадрам, неделимой остаётся атомарная фаза ~4.5 мс.
; 08-10 бой v247: худший шаг 5-8.3 -> 4.6-5.3 мс, куча 29-41 МБ не растёт, долг до 0.7 МБ и гаснет (0 = без предела)
lua_gc_step_max_us 1500
; кэш террейна (TerrainCache) нужен только параллаксу террейна (r_pom_terrain), а на Switch террейн -- R1-ветка
; TERRAIN_FLAT без него. 08-10 на бегу ([nx gpu slow], walk_v265): его перепекание 2048^2 каждые 4 м пути = 5.3 мс GPU
r_terra_cache 0
; не больше 16 объектов (NPC + его инвентарь) уходят в оффлайн за один обход ALife (100 мс), остальные -- в следующий.
; 09-10 на бегу: уход лагеря = 16-19 кадров по 22-31 мс (два NPC с ~15 предметами в одном кадре). 0 = без предела
al_offline_budget 16
; боевой ИИ v2 (командир, роли, место через асинхронный запрос позиции на втором потоке).
; 07-10 бой в деревне на Switch: кадров >33 мс 10 -> 2, худший 64 -> 43 мс (v1 выбирал укрытие
; наблюдателя лучами на главном, 11-23 мс); сам запрос 2-4 мс/с второго потока. Не сохраняется в user.ltx.
ai_tactics_v2 1

; --- дальность, текстуры, геометрия
r_wind_shadow_dist 0
rs_vis_distance 0.4
texture_lod 1
r__tf_aniso 1
r__geometry_lod 0.1
; v97: кэш DAG кластеров находится -- все страницы резидентны, без подкачки с SD
r_clpage 0
; v104: кадр упирается в CPU, GPU-приборы стоят CPU каждый кадр
r_profiler 0

; --- статика в R1-освещении (world_frag_body.glsl WORLD_FLAT), без отдельного препасса
r_world_flat 1

; --- звук (10-10): старт звука распаковывает 1 блок 400 мс, остальные 2 по одному за кадр (старт ~24 -> ~8 мс потока звука)
snd_start_blocks 1
; --- звук на DSP (11-10, audren, xrSound/SoundRender_CoreNX.h): 64 цели = 128 голосов DSP (обмен с рендерером ~0.4 мс
; на 96 целях -- меньше голосов = меньше данных за обновление); реверб комнаты считает DSP (I3DL2) -- включаем EFX-путь
snd_nx_voices 64
snd_efx on
; --- обновление xrSound прямо во втором потоке кадра, а не на воркере ядра 2 с ожиданием (11-10, ранний бой ai_test x2:
; звук 1.51 -> 1.29 мс, ожидание второго потока 3.1 -> 2.6, fps 56.0 -> 56.8/57.5; голодания аудио нет). Воркер ядра 2
; делил ядро с воркером частиц того же приоритета 0x2E, а такие потоки на Horizon друг друга не вытесняют.
snd_core -1
; --- второй поток в большом бою (12-10, cpu27, бой 12 бандитов x2 на режим): весь бой 2-й поток 5.4 -> 3.8-4.2 мс,
; ожидание второго потока 0.8 -> 0.3-0.46, p95 кадра 18.6 -> 18.0.
; Экспорт состояния онлайн-объектов в серверные сущности раз в 3 кадра (каждый кадр -- треть списка; игрок -- каждый
; кадр, сохранение -- полный проход): net_update 1.0 -> 0.5 мс.
net_export_div 3
; Тело, активное 2 с и дольше, ни один элемент которого 1.5 с не сдвигается >3 см / не поворачивается >2 град., замораживается
; (трупы-рэгдоллы дрожали по 40+ с, стол в подвале и ~25 предметов не спали с загрузки); удар/контакт/мотор будят:
; физика 2.2 -> 1.3 мс. ph_exact_joints 0 проверен -- ничего не даёт, оставлен стоковый 30.
ph_settle 1.5
