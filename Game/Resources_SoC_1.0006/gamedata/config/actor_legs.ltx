; ---------------------------------------------------------------------------
; First-person visible body (CActorFirstPersonBody).
;
; Toggle in console:  g_first_person_body 1
;
; Assets and animation tables are ported from Shoker Weapon Mod 2.1 / SWM Team
; (2013, Shoker & Kentaur), by way of the Anomaly port by Wang_Laoshi.
; The [legs_anims_*] tables below are GENERATED -- see tools/legs_port/.
; ---------------------------------------------------------------------------

[actor_legs]
visual                  = sm\actor_legs\no_outfit

; Which generated table drives the animation choice.
anim_table              = legs_anims_basic
anim_table_noncombat    = legs_anims_noncombat

; Vertical offset applied after the body is pinned to the actor's feet.
height                  = 0.0
height_ladder           = -0.1

; Stop drawing once the camera is further than this from the actor (vehicles,
; cutscene cameras, death cam).
hide_distance           = 2.0

; Body offset from the camera, along the view heading / its right vector.
; Negative forward pulls the body back so the chest is not in the near plane.
shift_fwd               = -0.65
; Used instead of shift_fwd while nothing is readied (SWM's calm stance leans back).
shift_fwd_noncombat     = -0.5
shift_rgt               = 0.0

; Fallback drops used only when the camera is detached from the actor capsule.
drop_stand              = 1.5
drop_crouch             = 1.23
drop_crouch_accel       = 0.95

; Camera-to-actor distance under which the feet are pinned to the actor capsule.
; A standing first-person camera sits ~1.65-1.75 above the feet, so this has to
; clear that -- key it off drop_stand and the pin never engages at all.
pin_distance            = 1.7

; Camera pitch below which the body stops following the view heading and sticks
; to the actor's own heading -- otherwise the legs pivot under you as you look
; down and turn.
look_down_threshold     = -0.65

; --- turning ---------------------------------------------------------------
; 1 = the body always faces where you are looking. 0 = SWM's original rule, where
; looking down hands the heading to the actor's own body -- and OGSR only realigns
; the actor after the camera has run 45 degrees away from it, so the torso
; visibly arrives a beat after the camera.
follow_view             = 1

; Rate limit on the body yaw, rad/s. 0 = follow the view exactly (default).
; Anything above 0 is deliberate weight -- and deliberate trailing on a fast turn.
turn_speed              = 0.0

; Yaw error that starts a step-turn cycle. The 'down' one applies while looking at
; your own feet, where a small misalignment is far more visible.
turn_threshold          = 0.2
turn_threshold_down     = 0.08
turn_hold_ms            = 500
turn_anim_left          = lancew_legs_turn_left
turn_anim_right         = lancew_legs_turn_right

; Per-cycle position overrides: <cycle> = forward, right
[legs_shifts]
leg_ladder_idle         = -0.15, 0.0
leg_ladder_up           = -0.15, 0.0
leg_ladder_down         = -0.15, 0.0
lancew_legs_sprint      = -0.65, 0.0
lancew_legs_idle_sc     = -1.5,  0.0
lancew_legs_walk_sc     = -1.5,  0.0
lancew_legs_walk_fl_sc  = -1.5,  0.0
lancew_legs_walk_fr_sc  = -1.5,  0.0


